+    const owner = normalizeOwner(expectedOwner);
+    const allowedKeys = new Set(["schemaVersion", "kind", "docKey", "documentId", "deviceId", "document", "nextSeq", "anchor", "tail"]);
+    if (!value || typeof value !== "object" || Array.isArray(value) ||
+        Object.keys(value).some((key) => !allowedKeys.has(key)) ||
+        value.schemaVersion !== 1 || value.kind !== "pdf-reader-device-wal" ||
+        value.docKey !== normalized.docKey || value.documentId !== normalized.documentId ||
+        value.deviceId !== owner || !Number.isSafeInteger(value.nextSeq) || value.nextSeq < 1 ||
+        !value.anchor || typeof value.anchor !== "object" || Array.isArray(value.anchor) ||
+        Object.keys(value.anchor).some((key) => !["throughSeq", "annotations", "tombstones", "routing"].includes(key)) ||
+        !Number.isSafeInteger(value.anchor.throughSeq) || value.anchor.throughSeq < 0 ||
+        !value.anchor.annotations || typeof value.anchor.annotations !== "object" || Array.isArray(value.anchor.annotations) ||
+        !value.anchor.tombstones || typeof value.anchor.tombstones !== "object" || Array.isArray(value.anchor.tombstones) ||
+        !Object.prototype.hasOwnProperty.call(value.anchor, "routing") ||
+        (value.anchor.routing !== null &&
+          (typeof value.anchor.routing !== "object" || Array.isArray(value.anchor.routing))) ||
+        !Array.isArray(value.tail)) {
+      throw codedError("WAL_ENVELOPE_INVALID", "Device WAL schema, identity, anchor, or sequence is invalid.");
+    }
+    validateDocumentMetadata(value.document, normalized);
+
+    let maxOwnedSequence = 0;
+    const anchorOperations = operationsFromAnchor(value.anchor);
+    for (const operation of anchorOperations) {
+      const normalizedOperation = validateOperation(operation);
+      if (normalizedOperation.version.deviceId !== owner &&
+          !(normalizedOperation.version.deviceId === "legacy-import" &&
+            normalizedOperation.version.rev === 1 && normalizedOperation.seq === 0)) {
+        throw codedError("WAL_OWNER_MISMATCH", "A WAL anchor may contain only its owner's operations or the deterministic legacy-import baseline.");
+      }
+      if (normalizedOperation.version.deviceId === owner) {
+        maxOwnedSequence = Math.max(maxOwnedSequence, normalizedOperation.seq);
+        if (normalizedOperation.seq > value.anchor.throughSeq) {
+          throw codedError("WAL_ANCHOR_SEQUENCE_INVALID", "Anchor throughSeq must cover every owned anchor operation.");
+        }
+      }
+    }
+    let previousSeq = value.anchor.throughSeq;
+    for (const operation of value.tail) {
+      const normalizedOperation = validateOperation(operation);
+      if (normalizedOperation.version.deviceId !== owner) {
+        throw codedError("WAL_OWNER_MISMATCH", "A WAL tail contains an operation owned by another device.");
+      }
+      if (normalizedOperation.seq <= previousSeq) {
+        throw codedError("WAL_SEQUENCE_INVALID", "WAL tail sequences must strictly increase after anchor.throughSeq.");
+      }
+      previousSeq = normalizedOperation.seq;
+      maxOwnedSequence = Math.max(maxOwnedSequence, normalizedOperation.seq);
+    }
+    validateUniqueDeviceSequences([...anchorOperations, ...value.tail]);
+    if (value.nextSeq <= Math.max(value.anchor.throughSeq, maxOwnedSequence)) {
+      throw codedError("WAL_SEQUENCE_INVALID", "nextSeq must exceed every owned anchor and tail sequence.");
+    }
+    joinOperations(anchorOperations, value.tail);
+    return value;
+  }
+
+  async function readWal(document, owner = ownerId) {
+    const normalized = normalizeIdentity(document);
+    const device = normalizeOwner(owner);
+    const wal = await io.readJsonWithDocumentIdentity(pathFor(normalized, device), {
+      expectedIdentity: normalized,
+      validate: (value) => validateWal(value, normalized, device),
+      getIdentity: (value) => value?.document,
+      validateCandidate: (value, candidateIdentity) => validateWal(value, candidateIdentity, device),
+    });
+    if (!wal) return null;
+    checkWalProgress(adapter, normalized, device, wal, { record: true });
+    return normalizeWal(wal);
+  }
+
+  async function loadWals(document) {
+    const normalized = normalizeIdentity(document);
+    const valid = [];
+    const errors = [];
+    let listing;
+    try {
+      if (!(await adapter.exists(walRoot))) return { valid, errors };
+      listing = await io.list(walRoot);
+    } catch (error) {
+      return { valid, errors: [{ path: walRoot, code: error?.code || "WAL_LIST_FAILED", message: String(error?.message || error) }] };
+    }
+    for (const listed of listing.folders) {
+      const owner = normalizeListedPath(listed, walRoot);
+      if (!owner || owner.includes("/") || owner.includes("\\") || owner === "." || owner === "..") continue;
+      const walPath = pathFor(normalized, owner);
+      try {
+        if (!(await adapter.exists(walPath)) && !(await adapter.exists(`${walPath}.pending`))) continue;
+        const wal = await readWal(normalized, owner);
+        if (wal) valid.push({ deviceId: owner, wal, path: walPath });
+      } catch (error) {
+        errors.push({ deviceId: owner, path: walPath, code: error?.code || "WAL_INVALID", message: String(error?.message || error) });
+      }
+    }
+    valid.sort((left, right) => left.deviceId < right.deviceId ? -1 : left.deviceId > right.deviceId ? 1 : 0);
+    return { valid, errors };
+  }
+
+  async function writeWalUnlocked(document, input, { allowPrune = false } = {}) {
+    const normalized = normalizeIdentity(document);
+    if (!input || typeof input !== "object" || Array.isArray(input)) {
+      throw codedError("WAL_ENVELOPE_INVALID", "writeWal requires a device WAL object.");
+    }
+    const owner = normalizeOwner(input.deviceId || ownerId);
+    if (owner !== ownerId) throw codedError("WAL_OWNER_MISMATCH", "A store may write only its own device WAL.");
+    let existing = await readWal(normalized, owner);
+    const metadata = input.document || existing?.document || defaultDocumentMetadata(normalized);
+    validateDocumentMetadata(metadata, normalized);
+    if (existing && canonicalJson(existing.document) !== canonicalJson(metadata)) {
+      throw codedError("WAL_DOCUMENT_METADATA_IMMUTABLE", "WAL.document metadata cannot change after first persistence.");
+    }
+
+    const anchor = {
+      throughSeq: input.anchor?.throughSeq,
+      operations: operationsFromAnchor(input.anchor),
+    };
+    const tail = Array.isArray(input.tail) ? input.tail.map(validateOperation) : [];
+    const nextSeq = input.nextSeq;
+    const previousNextSeq = existing?.nextSeq || 1;
+    const previousThroughSeq = existing?.anchor?.throughSeq || 0;
+    if (!Number.isSafeInteger(anchor.throughSeq) || anchor.throughSeq < previousThroughSeq ||
+        !Number.isSafeInteger(nextSeq) || nextSeq < previousNextSeq ||
+        nextSeq <= Math.max(anchor.throughSeq, tail.at(-1)?.seq || 0)) {
+      throw codedError("WAL_WATERMARK_REGRESSION", "WAL anchor and nextSeq watermarks must remain monotonic.");
+    }
+
+    if (existing) {
+      const newRows = [...anchor.operations, ...tail];
+      const newTexts = new Set(newRows.map((operation) => canonicalJson(operation)));
+      if (!allowPrune) {
+        for (const oldOperation of operationRows(existing)) {
+          if (!newTexts.has(canonicalJson(oldOperation))) {
+            throw codedError("WAL_HISTORY_PRUNED", "A WAL write cannot remove an operation outside verified compaction.");
+          }
+        }
+      }
+      const oldTailTexts = new Set(existing.tail.map((operation) => canonicalJson(operation)));
+      for (const operation of tail) {
+        if (oldTailTexts.has(canonicalJson(operation))) continue;
+        if (operation.version.deviceId !== owner || operation.seq < previousNextSeq ||
+            operation.seq <= anchor.throughSeq) {
+          throw codedError("WAL_SEQUENCE_REGRESSION", "New WAL tail operations must belong to this device and follow nextSeq/anchor.throughSeq.");
+        }
+      }
+    }
+
+    const internalValue = {
+      schemaVersion: 1,
+      kind: "pdf-reader-device-wal",
+      documentId: normalized.documentId,
+      docKey: normalized.docKey,
+      deviceId: owner,
+      document: metadata,
+      anchor,
+      tail,
+      nextSeq,
+    };
+    validateWal({ ...internalValue, anchor: { throughSeq: anchor.throughSeq, ...mapsFromOperations(anchor.operations) } }, normalized, owner);
+    const diskValue = {
+      ...internalValue,
+      anchor: { throughSeq: anchor.throughSeq, ...mapsFromOperations(anchor.operations) },
+    };
+    checkWalProgress(adapter, normalized, owner, diskValue);
+    const written = await io.writeJsonAtomic(pathFor(normalized, owner), diskValue, {
+      validate: (candidate) => validateWal(candidate, normalized, owner),
+    });
+    checkWalProgress(adapter, normalized, owner, written, { record: true });
+    return normalizeWal(written);
+  }
+
+  async function writeWal(document, wal, options = {}) {
+    const normalized = normalizeIdentity(document);
+    return runQueuedWalWrite(adapter, ownerId, normalized.docKey,
+      () => writeWalUnlocked(normalized, wal, options));
+  }
+
+  const compactor = createWalCompactor({
+    adapter,
+    root: baseRoot,
+    hash,
+    verifyHash,
+    deviceId: ownerId,
+    token,
+    thresholds,
+    sidecarStore,
+    loadWals,
+    readWal,
+    writeWalUnlocked,
+  });
+
+  return Object.freeze({
+    pathFor,
+    loadWals,
+    readWal,
+    writeWal,
+    writeWalUnlocked,
+    compact: compactor.compact,
+    validateWal,
+    deviceId: ownerId,
+    root: baseRoot,
+  });
+}
+
+module.exports = { createWalStore };
diff --git a/plugin/storage/wal-writer-coordinator.cjs b/plugin/storage/wal-writer-coordinator.cjs
new file mode 100644
index 0000000..e70269b
--- /dev/null
+++ b/plugin/storage/wal-writer-coordinator.cjs
@@ -0,0 +1,48 @@
+/* Copyright 2026 XxX-42 and contributors; SPDX-License-Identifier: Apache-2.0 */
+"use strict";
+
+// Module-level WeakMap means every store factory in this JavaScript realm
+// shares the same queue for an adapter/device/document tuple.
+const queuesByAdapter = new WeakMap();
+
+function createWalWriterCoordinator() {
+  async function run(adapter, deviceId, docKey, operation) {
+    if (!adapter || (typeof adapter !== "object" && typeof adapter !== "function")) {
+      throw new TypeError("A DataAdapter object is required for WAL coordination.");
+    }
+    if (typeof deviceId !== "string" || !deviceId || typeof docKey !== "string" || !docKey) {
+      throw new TypeError("WAL coordination requires a deviceId and docKey.");
+    }
+    if (typeof operation !== "function") throw new TypeError("A queued WAL operation must be a function.");
+
+    let queues = queuesByAdapter.get(adapter);
+    if (!queues) {
+      queues = new Map();
+      queuesByAdapter.set(adapter, queues);
+    }
+    const key = `${deviceId.length}:${deviceId}${docKey.length}:${docKey}`;
+    const previous = queues.get(key) || Promise.resolve();
+    const result = previous.catch(() => {}).then(operation);
+    const settled = result.then(() => undefined, () => undefined);
+    queues.set(key, settled);
+
+    try {
+      return await result;
+    } finally {
+      if (queues.get(key) === settled) {
+        queues.delete(key);
+        if (queues.size === 0) queuesByAdapter.delete(adapter);
+      }
+    }
+  }
+
+  return Object.freeze({ run });
+}
+
+const sharedCoordinator = createWalWriterCoordinator();
+
+module.exports = {
+  createWalWriterCoordinator,
+  createCoordinator: createWalWriterCoordinator,
+  runQueuedWalWrite: sharedCoordinator.run,
+};
diff --git a/scripts/benchmark-wal-sidecar.mjs b/scripts/benchmark-wal-sidecar.mjs
new file mode 100644
index 0000000..f31cc03
--- /dev/null
+++ b/scripts/benchmark-wal-sidecar.mjs
@@ -0,0 +1,334 @@
+#!/usr/bin/env node
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { mkdir, readFile, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { createRequire } from "node:module";
+import { fileURLToPath } from "node:url";
+
+// This is a Node process benchmark over an in-memory DataAdapter-compatible
+// implementation. Platform names below are compatibility labels only; no
+// native Windows, macOS, or iPadOS device is measured by this script.
+const require = createRequire(import.meta.url);
+const { createWalAnnotationStore } = require("../plugin/storage/wal-annotation-store.cjs");
+const { canonicalJson } = require("../plugin/storage/canonical.cjs");
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+const FIXTURE = path.resolve(HERE, "../tests/fixtures/tracemonkey.pdf");
+const STORAGE_ROOT = "00_Archive/20_PDFData";
+const DEVICE_ID = "benchmark-device";
+const EDIT_COUNT = 10;
+const BASE64_BYTES = 100 * 1024;
+const FLOAT32_BYTES = BASE64_BYTES / 4 * 3;
+const PLATFORM_LABELS = ["Windows", "macOS", "iPadOS"];
+
+function taggedSha256(value) {
+  const bytes = value instanceof Uint8Array ? value : new Uint8Array(value);
+  return `sha256-v1:${createHash("sha256").update(bytes).digest("hex")}`;
+}
+
+function utf8ByteLength(value) {
+  if (typeof value === "string") return new TextEncoder().encode(value).byteLength;
+  if (value instanceof ArrayBuffer) return value.byteLength;
+  if (ArrayBuffer.isView(value)) return value.byteLength;
+  throw new TypeError("The benchmark adapter received a non-string, non-byte write.");
+}
+
+function createMemoryDataAdapter() {
+  const files = new Map();
+  const folders = new Set();
+  let writeCalls = 0;
+  let utf8WriteBytes = 0;
+  const adapter = {
+    async exists(entry) { return files.has(entry) || folders.has(entry); },
+    async mkdir(entry) { folders.add(entry); },
+    async read(entry) {
+      if (!files.has(entry)) throw new Error(`Missing DataAdapter entry: ${entry}`);
+      return files.get(entry);
+    },
+    async write(entry, value) {
+      if (typeof value !== "string") throw new TypeError("Expected UTF-8 text from the WAL storage runtime.");
+      const parent = entry.includes("/") ? entry.slice(0, entry.lastIndexOf("/")) : "";
+      if (parent && !folders.has(parent)) throw new Error(`Parent directory missing: ${parent}`);
+      files.set(entry, value);
+      writeCalls += 1;
+      utf8WriteBytes += utf8ByteLength(value);
+    },
+    async rename(from, to) {
+      if (!files.has(from)) throw new Error(`Missing rename source: ${from}`);
+      if (files.has(to)) throw new Error(`Rename target exists: ${to}`);
+      files.set(to, files.get(from));
+      files.delete(from);
+    },
+    async remove(entry) { files.delete(entry); },
+    async list(directory) {
+      const prefix = `${directory}/`;
+      const childFiles = [];
+      const childFolders = new Set();
+      for (const entry of [...files.keys(), ...folders]) {
+        if (!entry.startsWith(prefix)) continue;
+        const rest = entry.slice(prefix.length);
+        if (rest.includes("/")) childFolders.add(rest.slice(0, rest.indexOf("/")));
+        else if (files.has(entry)) childFiles.push(rest);
+        else if (rest) childFolders.add(rest);
+      }
+      return { files: childFiles, folders: [...childFolders] };
+    },
+  };
+  return {
+    adapter,
+    files,
+    folders,
+    stats: () => ({ writeCalls, utf8WriteBytes }),
+  };
+}
+
+function createInkPayload(iteration) {
+  // 76,800 raw Float32LE bytes encode to exactly 102,400 Base64 characters
+  // (100 KiB). They represent 9,600 x/y points in one Ink path.
+  const raw = Buffer.alloc(FLOAT32_BYTES);
+  for (let offset = 0; offset < raw.byteLength; offset += 4) {
+    const point = offset / 8;
+    const coordinate = (offset / 4) % 2;
+    const value = coordinate === 0
+      ? Math.sin(point / 41) * 720 + iteration * 0.05
+      : Math.cos(point / 37) * 960 + iteration * 0.05;
+    raw.writeFloatLE(value, offset);
+  }
+  const data = raw.toString("base64");
+  assert.equal(data.length, BASE64_BYTES, "the benchmark Ink path must encode to exactly 100 KiB of Base64");
+  return {
+    editor: {
+      type: "ink",
+      color: [0.12, 0.3, 0.72],
+      thickness: 2.25,
+      paths: [{ encoding: "float32le-base64-v1", data, pointCount: FLOAT32_BYTES / 8 }],
+    },
+  };
+}
+
+function logicalPageIdentities() {
+  return Array.from({ length: 120 }, (_, index) => `logical-page-${String(index).padStart(3, "0")}`);
+}
+
+function memorySnapshot(label) {
+  const usage = process.memoryUsage();
+  return {
+    label,
+    rssBytes: usage.rss,
+    heapUsedBytes: usage.heapUsed,
+    heapTotalBytes: usage.heapTotal,
+    externalBytes: usage.external,
+    arrayBuffersBytes: usage.arrayBuffers,
+  };
+}
+
+function summarize(samples) {
+  const sorted = [...samples].sort((left, right) => left - right);
+  const sum = samples.reduce((total, value) => total + value, 0);
+  const middle = Math.floor(sorted.length / 2);
+  const median = sorted.length % 2 ? sorted[middle] : (sorted[middle - 1] + sorted[middle]) / 2;
+  const percentileIndex = Math.max(0, Math.ceil(0.9 * sorted.length) - 1);
+  const round = (number) => Number(number.toFixed(3));
+  return {
+    N: samples.length,
+    meanMs: round(sum / samples.length),
+    medianMs: round(median),
+    p90Ms: round(sorted[percentileIndex]),
+    maxMs: round(sorted.at(-1)),
+  };
+}
+
+function timeMs(startedAt) {
+  return performance.now() - startedAt;
+}
+
+async function runVariant(platformLabel, fixtureBytes, sourceHash) {
+  const storeAdapter = createMemoryDataAdapter();
+  let id = 0;
+  // Use the same storage core, deterministic identity, fixture, and memory
+  // adapter contract for every platform compatibility label.
+  const store = createWalAnnotationStore({
+    adapter: storeAdapter.adapter,
+    root: STORAGE_ROOT,
+    deviceId: DEVICE_ID,
+    uuid: () => `benchmark-uuid-${++id}`,
+    hash: taggedSha256,
+    identityHash: taggedSha256,
+    clock: () => 1_800_000_000_000 + id,
+  });
+  const source = {
+    sourceHash,
+    fastHash: sourceHash,
+    size: fixtureBytes.byteLength,
+    pageCount: 120,
+    orderedPageIdentities: logicalPageIdentities(),
+  };
+  const document = await store.registerDocument({ sourcePath: "Benchmarks/tracemonkey-120-page-model.pdf", source });
+  const payloads = Array.from({ length: EDIT_COUNT }, (_, index) => createInkPayload(index + 1));
+  const memory = [memorySnapshot("before-edits")];
+  const saveSamples = [];
+  const readSamples = [];
+  let lastSnapshot = null;
+
+  for (let index = 0; index < EDIT_COUNT; index += 1) {
+    const saveStart = performance.now();
+    const saved = await store.appendOperations({
+      document,
+      sourceHash,
+      batchId: `benchmark-edit-${String(index + 1).padStart(2, "0")}`,
+      operations: [{
+        uuid: "benchmark-large-ink",
+        kind: "Ink",
+        pageIndex: 60,
+        deleted: false,
+        clock: {
+          timestamp: 1_800_000_000_000 + index,
+          logical: index,
+          deviceId: "benchmark-viewer",
+          opId: `benchmark-origin-${String(index + 1).padStart(2, "0")}`,
+        },
+        payload: payloads[index],
+      }],
+    });
+    saveSamples.push(timeMs(saveStart));
+    assert.equal(saved.acknowledged, true);
+    assert.equal(saved.operationCount, 1, "each benchmark save contributes one dirty annotation operation");
+
+    const readStart = performance.now();
+    lastSnapshot = await store.readDocument(document);
+    readSamples.push(timeMs(readStart));
+    assert.equal(lastSnapshot.annotations.length, 1);
+    assert.equal(lastSnapshot.annotations[0].uuid, "benchmark-large-ink");
+    assert.equal(lastSnapshot.annotations[0].payload.editor.paths[0].data.length, BASE64_BYTES);
+  }
+  memory.push(memorySnapshot("after-10-save-read-cycles"));
+
+  const beforeCompact = await store.readEffective(document);
+  const beforeWal = beforeCompact.valid.find((wal) => wal.deviceId === DEVICE_ID);
+  assert.ok(beforeWal, "the local device WAL must exist before compaction");
+  assert.equal(beforeWal.tail.length, EDIT_COUNT, "the benchmark should accumulate ten successive WAL edits");
+  const walPath = `${STORAGE_ROOT}/wal/${DEVICE_ID}/${document.docKey}.json`;
+  const preCompactWalText = storeAdapter.files.get(walPath);
+  assert.equal(typeof preCompactWalText, "string", "the active WAL must be stored by the adapter");
+  const preCompactWalBytes = new TextEncoder().encode(preCompactWalText).byteLength;
+
+  const compactStart = performance.now();
+  await store.materializeSnapshot(document);
+  const compactMs = timeMs(compactStart);
+  const afterCompact = await store.readEffective(document);
+  const compactedWal = afterCompact.valid.find((wal) => wal.deviceId === DEVICE_ID);
+  assert.ok(afterCompact.sidecar, "compaction publishes the verified sidecar snapshot");
+  assert.ok(compactedWal);
+  assert.equal(compactedWal.tail.length, 0, "the large WAL is compacted into its verified anchor and sidecar");
+
+  lastSnapshot = await store.readDocument(document);
+  assert.equal(lastSnapshot.annotations.length, 1);
+  assert.deepEqual(lastSnapshot.annotations[0].payload, payloads.at(-1));
+  memory.push(memorySnapshot("after-compaction"));
+
+  const sidecarPath = store.pathsFor(document).snapshot;
+  const walText = storeAdapter.files.get(walPath);
+  const sidecarText = storeAdapter.files.get(sidecarPath);
+  assert.equal(typeof walText, "string");
+  assert.equal(typeof sidecarText, "string");
+  const finalState = {
+    documentId: document.documentId,
+    docKey: document.docKey,
+    sourceHash,
+    annotations: lastSnapshot.annotations.map(({ uuid, kind, pageIndex, payload }) => ({ uuid, kind, pageIndex, payload })),
+    tombstones: lastSnapshot.tombstones.map(({ uuid, kind, pageIndex }) => ({ uuid, kind, pageIndex })),
+    orderedPageIdentities: source.orderedPageIdentities,
+  };
+  const semanticDigest = taggedSha256(new TextEncoder().encode(canonicalJson(finalState)));
+  const adapterStats = storeAdapter.stats();
+
+  return {
+    platformLabel,
+    evidenceClass: "Node memory adapter only; compatibility label, not native platform evidence",
+    storageCore: "createWalAnnotationStore (same implementation for all labels)",
+    adapter: "in-memory DataAdapter-compatible harness",
+    fixture: "tests/fixtures/tracemonkey.pdf",
+    fixtureBytes: fixtureBytes.byteLength,
+    sourceHash,
+    pageIdentityMode: "120 deterministic logical page identities for storage cardinality; not a claim about fixture page count",
+    pageCount: source.pageCount,
+    inkPayload: {
+      kind: "Ink",
+      rawFloat32leBytes: FLOAT32_BYTES,
+      base64Characters: payloads.at(-1).editor.paths[0].data.length,
+      points: FLOAT32_BYTES / 8,
+      dirtyOperations: EDIT_COUNT,
+    },
+    timings: {
+      save: summarize(saveSamples),
+      read: summarize(readSamples),
+      compact: summarize([compactMs]),
+    },
+    adapterWrites: {
+      calls: adapterStats.writeCalls,
+      actualUtf8Bytes: adapterStats.utf8WriteBytes,
+    },
+    storage: {
+      fileCount: storeAdapter.files.size,
+      folderCount: storeAdapter.folders.size,
+      preCompactionWalBytes: preCompactWalBytes,
+      walSizeBytes: new TextEncoder().encode(walText).byteLength,
+      sidecarSizeBytes: new TextEncoder().encode(sidecarText).byteLength,
+      tailOperationsAfterCompaction: compactedWal.tail.length,
+      anchorOperationsAfterCompaction: compactedWal.anchor.operations.length,
+    },
+    memorySnapshots: memory,
+    semanticDigest,
+  };
+}
+
+async function main() {
+  const outputArgument = process.argv[2];
+  if (!outputArgument) throw new Error("Usage: node scripts/benchmark-wal-sidecar.mjs <output.json>");
+  const fixtureBefore = new Uint8Array(await readFile(FIXTURE));
+  const sourceHashBefore = taggedSha256(fixtureBefore);
+  const processMemoryBefore = memorySnapshot("process-before-benchmarks");
+  const variants = [];
+  for (const platformLabel of PLATFORM_LABELS) {
+    variants.push(await runVariant(platformLabel, fixtureBefore, sourceHashBefore));
+  }
+  const fixtureAfter = new Uint8Array(await readFile(FIXTURE));
+  const sourceHashAfter = taggedSha256(fixtureAfter);
+  assert.equal(sourceHashAfter, sourceHashBefore, "the real source fixture must remain unchanged");
+  assert.deepEqual(fixtureAfter, fixtureBefore, "the benchmark must not modify the source PDF fixture");
+  const semanticDigests = [...new Set(variants.map((variant) => variant.semanticDigest))];
+  assert.equal(semanticDigests.length, 1, "the shared WAL core produces the same semantic state for each adapter label");
+
