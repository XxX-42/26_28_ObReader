+    type: "ROUTE_SET",
+    seq: 0,
+    opId: "legacy-import:route",
+    version: { ...version },
+    payload: {
+      initialPath: identity.initialPath,
+      sourcePath: exported.document.sourcePath,
+      source: cloneJson(source),
+      sourceHash: identity.fullSourceHash,
