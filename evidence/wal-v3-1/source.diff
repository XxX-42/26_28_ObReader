+      throw importConflict("The Format 3 export contains an ambiguous effective UUID set.");
+    }
+    seen.add(row.uuid);
+  }
+  if (value.snapshot.annotations.some((row) => row.deleted === true) ||
+      value.snapshot.tombstones.some((row) => row.deleted !== true)) {
