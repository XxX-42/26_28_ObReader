+function importConflict(message, cause) {
+  const error = Object.assign(new Error(message), { code: "PDF_FORMAT3_IMPORT_CONFLICT" });
+  if (cause !== undefined) error.cause = cause;
+  return error;
+}
+
+module.exports = { createFormat3Importer };
