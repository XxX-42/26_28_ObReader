+  assert.equal(recovered.duplicate, true);
+  assert.equal(recovered.imported, false);
+  assert.equal(baselineWrites.length, 2, "the retry seeds the WAL anchor after verifying the existing sidecar");
+  assert.deepEqual(joinOperations(baselineWrites.at(-1).sidecar.operations), prepared.expectedState);
+  assert.equal(shared.files.get(sidecarPath), interruptedSidecarText,
+    "a repeated import leaves the valid sidecar byte-for-byte unchanged");
+
+  const writesBeforeRepeat = shared.writes.length;
+  const repeated = await importer.importDocument("Books/Imported.pdf");
+  assert.equal(repeated.duplicate, true);
+  assert.equal(shared.writes.length, writesBeforeRepeat, "a matching import does not rewrite the new sidecar");
+
+  const changedLegacy = await legacy.appendOperations({
+    document,
+    batchId: "later-live-change",
+    operations: [row("new-uuid", "Square", 1_020, { rect: [0, 0, 10, 10] })],
+  });
+  assert.ok(changedLegacy.acknowledged);
+  const unchangedSidecarText = shared.files.get(sidecarPath);
+  await assert.rejects(importer.importDocument("Books/Imported.pdf"), { code: "PDF_FORMAT3_IMPORT_CONFLICT" });
+  assert.equal(shared.files.get(sidecarPath), unchangedSidecarText,
+    "changed legacy state fails closed instead of overwriting the imported sidecar");
+});
+
+test("Format 3 export fails closed on an incomplete operation and never repairs it", async () => {
+  const { adapter, shared } = makeAdapter();
+  const legacy = makeLegacyStore(adapter);
+  const document = await legacy.registerDocument({ sourcePath: "Books/Partial.pdf", source: { sourceHash: hash("partial PDF") } });
+  const appended = await legacy.appendOperations({
+    document,
+    batchId: "partial-batch",
+    operations: [row("partial", "Underline", 1_100, { quads: [0, 1, 2, 3] })],
+  });
+  shared.files.set(appended.batchPath, "{partial");
+  const beforeWrites = shared.writes.length;
+  const beforeRenames = shared.renames.length;
+  const beforeRemoves = shared.removes.length;
+  const beforeMkdirs = shared.mkdirs.length;
+  await assert.rejects(legacy.exportForMigration("Books/Partial.pdf"), { code: "PDF_ANNOTATION_SYNC_PENDING" });
+  assert.equal(shared.writes.length, beforeWrites);
+  assert.equal(shared.renames.length, beforeRenames);
+  assert.equal(shared.removes.length, beforeRemoves);
+  assert.equal(shared.mkdirs.length, beforeMkdirs);
+});
+
+test("one-shot sidecar bytes ignore device-local source modification times", async () => {
+  const { adapter } = makeAdapter();
+  const legacy = makeLegacyStore(adapter);
+  const sourceHash = hash("same full source bytes on both devices");
+  const document = await legacy.registerDocument({
+    sourcePath: "Books/Deterministic-import.pdf",
+    source: {
+      sourceHash,
+      fastHash: sourceHash,
+      size: 52_001,
+      pageCount: 2,
+      orderedPageIdentities: ["21 0 R", "34 0 R"],
+      mtime: 1_728_000_000_000,
+    },
+  });
+  await legacy.appendOperations({
+    document,
+    batchId: "deterministic-current-state",
+    operations: [row("same-live-uuid", "Underline", 1_301, { quads: [[1, 2, 3, 4]] })],
+  });
+  await legacy.readDocument(document);
+  await legacy.readDocument(document);
+  const exported = await legacy.exportForMigration(document);
+  const otherDeviceExport = structuredClone(exported);
+  otherDeviceExport.document.source.mtime = 1_760_000_000_000;
+
+  const firstAdapter = makeAdapter();
+  const secondAdapter = makeAdapter();
+  const persistedA = createSidecarStore({ adapter: firstAdapter.adapter, root: "00_Archive/20_PDFData", hash });
+  const persistedB = createSidecarStore({ adapter: secondAdapter.adapter, root: "00_Archive/20_PDFData", hash });
+  const importerA = createFormat3Importer({ sidecarStore: persistedA, stableHash: hash });
+  const importerB = createFormat3Importer({ sidecarStore: persistedB, stableHash: hash });
+  const preparedA = await importerA.prepareImport(exported);
+  const preparedB = await importerB.prepareImport(otherDeviceExport);
+
+  for (const prepared of [preparedA, preparedB]) {
+    assert.equal(Object.hasOwn(prepared.sidecar.document.source, "mtime"), false);
+    assert.equal(Object.hasOwn(prepared.sidecar.operations.find((operation) => operation.type === "ROUTE_SET").payload.source, "mtime"), false);
+    assert.equal(prepared.sidecar.document.source.sourceHash, sourceHash);
+    assert.equal(prepared.sidecar.document.source.size, 52_001);
+    assert.equal(prepared.sidecar.document.source.pageCount, 2);
+    assert.deepEqual(prepared.sidecar.document.source.orderedPageIdentities, ["21 0 R", "34 0 R"]);
+  }
+  assert.equal(preparedA.identity.documentId, preparedB.identity.documentId);
+  assert.deepEqual(preparedA.sidecar.operations, preparedB.sidecar.operations);
+
+  await Promise.all([
+    persistedA.writeSidecar(preparedA.identity, preparedA.sidecar),
+    persistedB.writeSidecar(preparedB.identity, preparedB.sidecar),
+  ]);
+  const sidecarPath = persistedA.pathFor(preparedA.identity);
+  const bytesA = firstAdapter.shared.files.get(sidecarPath);
+  const bytesB = secondAdapter.shared.files.get(sidecarPath);
+  assert.equal(bytesA, bytesB, "sealed sidecar serialization is byte-identical across device-local mtimes");
+});
diff --git a/tests/wal-model.test.mjs b/tests/wal-model.test.mjs
new file mode 100644
index 0000000..c94160e
--- /dev/null
+++ b/tests/wal-model.test.mjs
@@ -0,0 +1,204 @@
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { createRequire } from "node:module";
+import test from "node:test";
+
+const require = createRequire(import.meta.url);
+const { canonicalJson, seal, verify } = require("../plugin/storage/canonical.cjs");
+const { compareVersion, validateVersion } = require("../plugin/storage/version.cjs");
+const { joinOperations, validateOperation } = require("../plugin/storage/merge-engine.cjs");
+const { deriveDocumentIdentity, normalizeInitialPath, validateFullSourceHash } = require("../plugin/storage/document-identity.cjs");
+const { buildEffectiveState, effectiveStatesEqual } = require("../plugin/storage/effective-state.cjs");
+
+const sha256 = (bytes) => `sha256-v1:${createHash("sha256").update(bytes).digest("hex")}`;
+
+function operation(type, {
+  uuid = "ann-a",
+  rev = 1,
+  deviceId = "device-a",
+  seq = 0,
+  opId = `${deviceId}-${rev}-${seq}`,
+  payload,
+  kind = "highlight",
+  pageIndex = 0,
+  ...extra
+} = {}) {
+  return {
+    type,
+    ...(uuid === undefined ? {} : { uuid }),
+    seq,
+    opId,
+    version: { rev, deviceId, seq },
+    ...(payload === undefined ? {} : { payload }),
+    ...(kind === undefined ? {} : { kind }),
+    ...(pageIndex === undefined ? {} : { pageIndex }),
+    ...extra,
+  };
+}
+
+function setOp(uuid, rev, value, extras = {}) {
+  return operation("ANNOTATION_SET", {
+    uuid,
+    rev,
+    payload: {
+      uuid,
+      type: "Highlight",
+      rect: { encoding: "float32le-base64-v1", data: value },
+    },
+    ...extras,
+  });
+}
+
+function deleteOp(uuid, rev, extras = {}) {
+  return operation("ANNOTATION_DELETE", { uuid, rev, ...extras });
+}
+
+function permutations(values) {
+  if (values.length <= 1) return [values];
+  return values.flatMap((value, index) =>
+    permutations([...values.slice(0, index), ...values.slice(index + 1)]).map((tail) => [value, ...tail]));
+}
+
+test("canonical JSON sorts nested keys and preserves Float32LE encoded payload objects", () => {
+  const source = {
+    z: 3,
+    a: { z: ["a", { q: true, b: 2 }], encoding: "float32le-base64-v1" },
+  };
+  assert.equal(
+    canonicalJson(source),
+    '{"a":{"encoding":"float32le-base64-v1","z":["a",{"b":2,"q":true}]},"z":3}',
+  );
+  assert.throws(() => canonicalJson({ n: Number.NaN }), { code: "WAL_CANONICAL_INVALID_VALUE" });
+  const cyclic = {};
+  cyclic.self = cyclic;
+  assert.throws(() => canonicalJson(cyclic), { code: "WAL_CANONICAL_CYCLE" });
+});
+
+test("seal and verify use the canonical unsigned envelope and reject changed contents", async () => {
+  const unsigned = {
+    schema: 1,
+    kind: "annotation-sidecar",
+    annotations: { b: { rev: 2 }, a: { rev: 1 } },
+  };
+  const signed = await seal(unsigned, sha256);
+  assert.match(signed.integrity, /^sha256-v1:[a-f0-9]{64}$/);
+  assert.deepEqual(await verify(signed, sha256), unsigned);
+  const changed = { ...signed, annotations: { ...signed.annotations, a: { rev: 3 } } };
+  await assert.rejects(verify(changed, sha256), { code: "WAL_INTEGRITY_MISMATCH" });
+  await assert.rejects(verify({ ...signed, integrity: "sha256-v1:abc" }, sha256), { code: "WAL_INTEGRITY_INVALID" });
+});
+
+test("version tuples compare by rev, then lexical deviceId, then seq", () => {
+  assert.deepEqual(validateVersion({ rev: 1, deviceId: "a", seq: 0 }), { rev: 1, deviceId: "a", seq: 0 });
+  assert.equal(compareVersion({ rev: 2, deviceId: "z", seq: 99 }, { rev: 1, deviceId: "a", seq: 0 }), 1);
+  assert.equal(compareVersion({ rev: 3, deviceId: "a", seq: 99 }, { rev: 3, deviceId: "b", seq: 0 }), -1);
+  assert.equal(compareVersion({ rev: 3, deviceId: "a", seq: 1 }, { rev: 3, deviceId: "a", seq: 2 }), -1);
+  assert.throws(() => validateVersion({ rev: 0, deviceId: "a", seq: 0 }), { code: "WAL_VERSION_INVALID" });
+  assert.throws(() => validateVersion({ rev: 1, deviceId: "bad\nactor", seq: 0 }), { code: "WAL_VERSION_INVALID" });
+});
+
+test("operation validation rejects malformed tuples and invalid annotation payload metadata", () => {
+  assert.throws(() => validateOperation({ type: "OTHER" }), { code: "WAL_OPERATION_INVALID" });
+  const mismatchedSeq = setOp("ann", 1, "v");
+  mismatchedSeq.seq = 4;
+  assert.throws(() => validateOperation(mismatchedSeq), { code: "WAL_OPERATION_INVALID" });
+  assert.throws(() => validateOperation(operation("ANNOTATION_SET", {
+    uuid: "ann", payload: "not-an-object", kind: "highlight", pageIndex: 0,
+  })), { code: "WAL_OPERATION_INVALID" });
+  assert.throws(() => validateOperation(operation("ANNOTATION_DELETE", {
+    uuid: "ann", kind: "unknown", pageIndex: 0,
+  })), { code: "WAL_OPERATION_INVALID" });
+  assert.throws(() => validateOperation(operation("ROUTE_SET", {
+    uuid: undefined, payload: { sourcePath: "../outside.pdf" }, kind: undefined, pageIndex: undefined,
+  })), { code: "WAL_OPERATION_INVALID" });
+});
+
+test("join is idempotent and commutative across operation permutations", () => {
+  const operations = [
+    setOp("ann-a", 1, "old"),
+    deleteOp("ann-a", 2, { deviceId: "device-b", opId: "delete-a" }),
+    setOp("ann-a", 3, "new", { seq: 1, opId: "edit-a-3" }),
+    setOp("ann-b", 1, "independent", { seq: 0, opId: "same-counter-other-uuid" }),
+  ];
+  const expected = joinOperations(operations);
+  assert.deepEqual(joinOperations(operations, operations), expected);
+  assert.deepEqual(joinOperations([]), { annotations: {}, tombstones: {}, routing: null });
+  for (const ordering of permutations(operations)) {
+    assert.deepEqual(joinOperations(ordering), expected);
+  }
+});
+
+test("same logical object and version cannot identify different op IDs or content", () => {
+  const original = setOp("ann-a", 1, "first");
+  const differentId = { ...original, opId: "different-op" };
+  const differentContent = { ...original, payload: { ...original.payload, note: "changed" } };
+  assert.throws(() => joinOperations([original, differentId]), { code: "VERSION_COLLISION" });
+  assert.throws(() => joinOperations([original, differentContent]), { code: "VERSION_COLLISION" });
+  // Equal tuples across different annotation UUIDs are separate logical keys.
+  assert.equal(Object.keys(joinOperations([original, setOp("ann-b", 1, "other")]).annotations).length, 2);
+});
+
+test("a tombstone wins by version and a later set clears it", () => {
+  const olderSet = setOp("ann-a", 7, "set");
+  const newerDelete = deleteOp("ann-a", 8, { deviceId: "device-z", opId: "delete" });
+  const tombstoned = joinOperations([olderSet, newerDelete]);
+  assert.deepEqual(Object.keys(tombstoned.annotations), []);
+  assert.equal(tombstoned.tombstones["ann-a"].opId, "delete");
+
+  const restored = joinOperations([olderSet, newerDelete, setOp("ann-a", 9, "restore")]);
+  assert.equal(restored.annotations["ann-a"].payload.rect.data, "restore");
+  assert.deepEqual(Object.keys(restored.tombstones), []);
+});
+
+test("effective state joins a verified sidecar, anchor records, and WAL tails", () => {
+  const sidecar = { kind: "annotation-sidecar", operations: [setOp("ann-a", 1, "sidecar")] };
+  const anchors = [{ kind: "annotation-anchor", operations: [setOp("ann-b", 1, "anchor")] }];
+  const tails = [{ kind: "annotation-wal", operations: [deleteOp("ann-a", 2)] }];
+  const effective = buildEffectiveState({ sidecar, anchors, tails });
+  assert.deepEqual(Object.keys(effective.annotations), ["ann-b"]);
+  assert.deepEqual(Object.keys(effective.tombstones), ["ann-a"]);
+  assert.equal(effective.routing, null);
+  assert.equal(effectiveStatesEqual(effective, joinOperations([setOp("ann-b", 1, "anchor"), deleteOp("ann-a", 2)])), true);
+});
+
+test("routing keeps the highest version and carries source and legacy metadata", () => {
+  const oldRoute = operation("ROUTE_SET", {
+    uuid: undefined,
+    rev: 1,
+    payload: { sourcePath: "Books/old.pdf", legacyIdentities: ["legacy-a"] },
+    kind: undefined,
+    pageIndex: undefined,
+  });
+  const newRoute = operation("ROUTE_SET", {
+    uuid: undefined,
+    rev: 2,
+    payload: { sourcePath: "Books/new.pdf", legacyIdentityScanComplete: true },
+    kind: undefined,
+    pageIndex: undefined,
+  });
+  assert.deepEqual(joinOperations([newRoute, oldRoute]).routing.payload, newRoute.payload);
+});
+
+test("document identity uses normalized initial path and the complete tagged source hash", async () => {
+  const sourceHash = `sha256-v1:${"a".repeat(64)}`;
+  assert.equal(normalizeInitialPath("./Books\\./Novel.pdf"), "Books/Novel.pdf");
+  assert.equal(validateFullSourceHash(sourceHash), sourceHash);
+  await assert.rejects(
+    Promise.resolve().then(() => validateFullSourceHash("xxh64-v1:deadbeef")),
+    { code: "WAL_SOURCE_HASH_INVALID" },
+  );
+
+  const identity = await deriveDocumentIdentity({ initialPath: "./Books\\Novel.pdf", fullSourceHash: sourceHash, stableHash: sha256 });
+  const normalized = await deriveDocumentIdentity({ initialPath: "Books/Novel.pdf", fullSourceHash: sourceHash, stableHash: sha256 });
+  const changedSource = await deriveDocumentIdentity({
+    initialPath: "Books/Novel.pdf", fullSourceHash: `sha256-v1:${"b".repeat(64)}`, stableHash: sha256,
+  });
+  assert.equal(identity.identity, normalized.identity);
+  assert.equal(identity.documentId, identity.identity);
+  assert.equal(identity.docKey.length, 12);
+  assert.notEqual(identity.identity, changedSource.identity);
+
+  const rawSha = (bytes) => createHash("sha256").update(bytes).digest("hex");
+  const rawIdentity = await deriveDocumentIdentity({ initialPath: "Books/Novel.pdf", fullSourceHash: sourceHash, stableHash: rawSha });
+  assert.equal(rawIdentity.identity, identity.identity);
+});
diff --git a/tests/wal-persistence.test.mjs b/tests/wal-persistence.test.mjs
new file mode 100644
index 0000000..b224e16
--- /dev/null
+++ b/tests/wal-persistence.test.mjs
@@ -0,0 +1,517 @@
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { createHash } from "node:crypto";
+import test from "node:test";
+import xxhash from "xxhash-wasm";
+
+const require = createRequire(import.meta.url);
+const { createSidecarStore } = require("../plugin/storage/sidecar-store.cjs");
+const { createWalStore } = require("../plugin/storage/wal-store.cjs");
+const { createWalWriterCoordinator } = require("../plugin/storage/wal-writer-coordinator.cjs");
+const { h64Raw } = await xxhash();
+
+function hash(value) {
+  return `sha256-v1:${createHash("sha256").update(value).digest("hex")}`;
+}
+
+function xxhHash(value) {
+  const bytes = value instanceof Uint8Array ? value : new TextEncoder().encode(value);
+  return `xxh64-v1:${h64Raw(bytes).toString(16).padStart(16, "0")}`;
+}
+
+function verifyEitherHash(bytes, expected) {
+  return expected.startsWith("sha256-v1:") ? hash(bytes) === expected : xxhHash(bytes) === expected;
+}
+
+function makeAdapter() {
+  const files = new Map();
+  const folders = new Set();
+  const control = { beforeWrite: null, beforeRename: null };
+  const adapter = {
+    async exists(path) { return files.has(path) || folders.has(path); },
+    async mkdir(path) { folders.add(path); },
+    async read(path) {
+      if (!files.has(path)) throw Object.assign(new Error(`missing: ${path}`), { code: "ENOENT" });
+      return files.get(path);
+    },
+    async write(path, value) {
+      const parent = path.includes("/") ? path.slice(0, path.lastIndexOf("/")) : "";
+      if (parent && !folders.has(parent)) throw new Error(`parent directory missing: ${parent}`);
+      if (control.beforeWrite) await control.beforeWrite(path, value);
+      files.set(path, value);
+    },
+    async rename(from, to) {
+      if (control.beforeRename) await control.beforeRename(from, to);
+      if (!files.has(from)) throw new Error(`missing rename source: ${from}`);
+      if (files.has(to)) throw new Error(`rename target exists: ${to}`);
+      files.set(to, files.get(from));
+      files.delete(from);
+    },
+    async remove(path) { files.delete(path); },
+    async list(path) {
+      const prefix = `${path}/`;
+      const directFiles = [];
+      const directFolders = new Set();
+      for (const file of files.keys()) {
+        if (!file.startsWith(prefix)) continue;
+        const remainder = file.slice(prefix.length);
+        if (remainder.includes("/")) directFolders.add(`${path}/${remainder.split("/")[0]}`);
+        else directFiles.push(file);
+      }
+      for (const folder of folders) {
+        if (!folder.startsWith(prefix)) continue;
+        const remainder = folder.slice(prefix.length);
+        if (remainder && !remainder.includes("/")) directFolders.add(folder);
+      }
+      return { files: directFiles, folders: [...directFolders] };
+    },
+  };
+  return { adapter, files, folders, control };
+}
+
+function documentIdentity() {
+  const fullSourceHash = hash(new TextEncoder().encode("source PDF"));
+  return {
+    documentId: "doc-identity-1",
+    docKey: "0123456789ab",
+    initialPath: "Books/Example.pdf",
+    fullSourceHash,
+    source: { fullHash: fullSourceHash, size: 2048, pageIdentities: ["page-a"] },
+    sourcePath: "Books/Example.pdf",
+    legacyIdentities: [],
+    legacyIdentityScanComplete: true,
+  };
+}
+
+function operation({ type = "ANNOTATION_SET", uuid = "ink-1", deviceId, seq, label, rev = 1 }) {
+  return {
+    type,
+    uuid,
+    kind: "Ink",
+    pageIndex: 0,
+    seq,
+    opId: `${deviceId}-${seq}-${label}`,
+    version: { rev, deviceId, seq },
+    ...(type === "ANNOTATION_SET" ? { payload: { uuid, kind: "Ink", pageIndex: 0, label } } : {}),
+  };
+}
+
+function stores(world, doc, deviceId) {
+  const sidecarStore = createSidecarStore({ adapter: world.adapter, root: "data", hash });
+  const walStore = createWalStore({ adapter: world.adapter, root: "data", hash, deviceId, sidecarStore });
+  return { sidecarStore, walStore };
+}
+
+function wal(document, deviceId, { anchor = [], throughSeq = 0, tail = [], nextSeq = 1 } = {}) {
+  return {
+    schemaVersion: 1,
+    kind: "pdf-reader-device-wal",
+    documentId: document.documentId,
+    docKey: document.docKey,
+    deviceId,
+    document,
+    anchor: { throughSeq, operations: anchor },
+    tail,
+    nextSeq,
+  };
+}
+
+function sidecar(document, operations) {
+  return {
+    schemaVersion: 1,
+    kind: "pdf-reader-materialized-sidecar",
+    document,
+    operations,
+    watermark: {},
+  };
+}
+
+test("sidecar write failure restores the last valid file", async () => {
+  const world = makeAdapter();
+  const document = documentIdentity();
+  const { sidecarStore } = stores(world, document, "device-a");
+  const first = operation({ deviceId: "device-a", seq: 1, label: "first" });
+  const second = operation({ deviceId: "device-a", seq: 2, label: "second" });
+  const path = sidecarStore.pathFor(document);
+  await sidecarStore.writeSidecar(document, sidecar(document, [first]));
+  const original = world.files.get(path);
+
+  let failOnce = true;
+  world.control.beforeWrite = async (writePath) => {
+    if (writePath !== path || !failOnce) return;
+    failOnce = false;
+    world.files.set(path, "{partial JSON");
+    throw new Error("simulated replacement failure");
+  };
+  await assert.rejects(sidecarStore.writeSidecar(document, sidecar(document, [second])));
+  world.control.beforeWrite = null;
+
+  assert.equal(world.files.get(path), original, "the previous complete sidecar is restored after replacement failure");
+  const restored = await sidecarStore.loadSidecar(document);
+  assert.deepEqual(restored.operations.map(({ opId }) => opId), [first.opId]);
+  assert.equal([...world.files.keys()].some((file) => file.endsWith(".previous")), false);
+});
+
+test("a partial canonical JSON file recovers from the verified pending write", async () => {
+  const world = makeAdapter();
+  const document = documentIdentity();
+  const { sidecarStore } = stores(world, document, "device-a");
+  const saved = operation({ deviceId: "device-a", seq: 1, label: "recover-me" });
+  const path = sidecarStore.pathFor(document);
+  await sidecarStore.writeSidecar(document, sidecar(document, [saved]));
+  world.files.set(`${path}.pending`, world.files.get(path));
+  world.files.set(path, "{\"schemaVersion\":1,");
+
+  const recovered = await sidecarStore.loadSidecar(document);
+  assert.deepEqual(recovered.operations.map(({ opId }) => opId), [saved.opId]);
+});
+
+test("a failed staging write leaves the prior sidecar intact across a crash boundary", async () => {
+  const world = makeAdapter();
+  const document = documentIdentity();
+  const { sidecarStore } = stores(world, document, "device-a");
+  const first = operation({ deviceId: "device-a", seq: 1, label: "first" });
+  const second = operation({ deviceId: "device-a", seq: 2, label: "second" });
+  const path = sidecarStore.pathFor(document);
+  await sidecarStore.writeSidecar(document, sidecar(document, [first]));
+  const original = world.files.get(path);
+
+  let failOnce = true;
+  world.control.beforeWrite = async (writePath) => {
+    if (writePath !== `${path}.pending` || !failOnce) return;
+    failOnce = false;
+    world.files.set(writePath, "{truncated");
+    throw new Error("simulated process interruption during staging");
+  };
+  await assert.rejects(sidecarStore.writeSidecar(document, sidecar(document, [second])));
+  world.control.beforeWrite = null;
+
+  assert.equal(world.files.get(path), original);
+  assert.deepEqual((await sidecarStore.loadSidecar(document)).operations.map(({ opId }) => opId), [first.opId]);
+});
+
+test("writing a subset preserves unrelated winners and tombstones from the existing sidecar", async () => {
+  const world = makeAdapter();
+  const document = documentIdentity();
+  const { sidecarStore } = stores(world, document, "device-a");
+  const preserved = operation({ uuid: "kept-annotation", deviceId: "device-a", seq: 1, label: "keep" });
+  const tombstone = operation({ type: "ANNOTATION_DELETE", uuid: "kept-tombstone", deviceId: "device-a", seq: 2, label: "delete" });
