{
  "name": "obsidian-pdf-web-reader",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run test:fast && npm run test:browser",
    "test:fast": "node scripts/test-vocabulary-gates.mjs fast",
    "test:browser": "node scripts/test-vocabulary-gates.mjs browser",
    "test:race": "node scripts/test-vocabulary-gates.mjs race",
    "test:vocabulary-nightly": "node scripts/test-vocabulary-nightly.mjs",
    "test:gates": "node scripts/test-vocabulary-gates.mjs all",
    "test:release": "npm run build && npm test && npm run test:offline",
    "test:offline": "node tests/offline-smoke.mjs",
    "test:network-firewall": "node tests/test-network-firewall-browser.mjs",
    "test:native": "node tests/native-obsidian-smoke.mjs && node tests/native-default-routing.mjs",
    "test:native:lifecycle": "node tests/native-macos-lifecycle.mjs",
    "test:native:background": "node tests/native-background.mjs",
    "test:native:learning-loop": "node tests/native-learning-loop.mjs",
    "test:native:release": "node tests/native-threefile-release.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@noble/hashes": "1.8.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.6",
    "puppeteer-core": "25.12.0",
    "ts-fsrs": "5.4.2"
  },
  "dependencies": {
    "@jspawn/qpdf-wasm": "0.0.2",
    "dexie": "4.4.6",
    "pdf-lib": "1.17.1",
    "xxhash-wasm": "1.1.0"
  }
}
